# Lotto Express Website (.env)
#
# NOTE: This repo must use its OWN secret key (do not reuse Winnow).

# CRM
CRM_BASE_URL=https://crm.example.com
CRM_API_SERVICE_KEY=replace_me_lottoexpress_service_key

# Website
WEBSITE_SECRET_KEY=replace_me_with_random_long_secret
WEBSITE_PORT=8003
WEBSITE_BRAND=lottoexpress
# Optional runtime marker used for safe feature toggles (e.g. local/test-only payment processor)
# Common values: local, test, production
WEBSITE_ENV=production

# Optional features
# Background sync of jackpots, draw results, prices and policies. The country
# block list is NOT part of this: it refreshes on its own regardless, because a
# country blocked in CRM Admin has to take effect without anyone setting a flag.
CRM_SYNC_ENABLE=0
# How often the CRM's country block list is re-read. Also the back-off after a
# failed attempt, so a CRM outage is not retried on every request.
COUNTRY_BLOCKS_REFRESH_SECONDS=300
CRM_CACHE_DB_PATH=/opt/lottoexpress-website/data/crm_cache.sqlite
CRM_CACHE_ONLY=0
CRM_PRODUCT_PRICES_REFRESH_SECONDS=86400
CRM_PRICE_FALLBACK_CURRENCY=EUR

# Admin access (set at least one in production)
WEBSITE_ADMIN_PASSWORD=
WEBSITE_ADMIN_TOKEN=

# GitHub pull safety (admin /admin/crm-cache)
# Encryption key for stored PAT: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
GITHUB_PULL_FERNET_KEY=
# REQUIRED: allowlist fragment for repo target, e.g. github.com/NewCo/lottoexpress-website.git
LOTTO_GITHUB_PULL_ALLOWED_REPO=
LOTTO_GITHUB_PULL_DEFAULT_USER=lottoexpress-bot
LOTTO_GITHUB_PULL_COMMAND_TEMPLATE=https://{github_user}:{github_key}@github.com/REPLACE_ME/REPLACE_ME.git main

# Store catalog refresh (how quickly new CRM products appear on the website)
CRM_STORE_GAMES_TTL_SECONDS=60

# Wallet top-up processor controls
# Default behavior:
# - website does NOT force a processor
# - CRM brand setting decides (emerchant/testing/etc)
# Optional override if needed (use only for targeted testing):
# WALLET_TOPUP_PROCESSOR=emerchant|testing
WALLET_TOPUP_PROCESSOR=

# Processors whose intents can be charged with a card entered on our own form.
# The CRM routes by country and reports direct-card capability per intent; this
# is the site's guard against a processor that advertises it but rejects the
# charge. A processor missing from here is sent to a hosted payment page
# instead, which fails if it has no hosted page configured — add a newly
# enabled CRM processor here rather than leaving it to fall through.
# The guard covers the `available` flag only. A processor answering
# `allowed`/`status` (TRAXX) is charged whether or not it is listed, so that a
# server carrying an older value for this list does not silently opt out.
# WALLET_DIRECT_CARD_PROCESSORS=eltrovox,emerchant,worldpay,testing,traxx

# Removed: WALLET_HPP_ONLY_PROCESSORS, WALLET_TOPUP_PROCESSOR_PROBE.
# Add Funds no longer guesses which processor a country routes to. It takes the
# amount, creates one intent, and shapes the payment step from what the CRM
# returns, so a hosted-only processor needs no configuring here.

# Optional analytics (leave blank to disable)
ANALYTICS_GTM_ID=
ANALYTICS_GA4_ID=

# Countries the site blocks itself, comma or space separated ISO2, e.g. "MT GB".
# Checked before the CRM's countries table and on its own authority, so a country
# can be cut off with an env change and a restart. Blocks both browsing (on the
# geo country) and registration (on the selected country). This is only the fast
# lever for something the CRM has not caught up with — the CRM's own
# `block_website` flag applies on its own, and covers every brand at once.
WEBSITE_BLOCKED_COUNTRIES_ISO2=

# The one request header trusted to carry the visitor's country. Our edge (Azure
# Front Door) sets X-Geo-Country. It must be a header the edge always overwrites,
# or visitors can send their own and walk through a country block. Other CDN
# headers are still read, but only when this one is absent.
GEO_COUNTRY_HEADER=X-Geo-Country
